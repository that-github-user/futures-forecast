# API backend URL
VITE_API_URL=http://localhost:8000
# API key (optional in dev mode)
VITE_API_KEY=

# DC Trading Dashboard
# DC API URL (empty = use Vite proxy in dev, set to full URL for production)
VITE_DC_API_URL=
# DC API key (optional in dev mode)
VITE_DC_API_KEY=
# Bcrypt hash of the DC dashboard password (generate with: npx bcryptjs hash <password>)
# Leave empty to disable password protection (dev mode)
VITE_DC_PASSWORD_HASH=
